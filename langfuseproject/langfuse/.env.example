# --- Core secrets (required) ---
SALT=
# generate via: openssl rand -hex 32
ENCRYPTION_KEY=
NEXTAUTH_SECRET=

# --- Datastore passwords ---
# DATABASE_URL must be kept in sync with POSTGRES_PASSWORD manually -- the
# compose file's default does NOT derive from POSTGRES_PASSWORD. Special
# characters in the password must be percent-encoded (e.g. % -> %25).
DATABASE_URL=postgresql://postgres:<POSTGRES_PASSWORD, url-encoded>@postgres:5432/postgres
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
REDIS_AUTH=
MINIO_ROOT_PASSWORD=
# Must match MINIO_ROOT_PASSWORD -- MinIO's root credentials double as the
# S3 access key/secret Langfuse uses for event/media/export uploads.
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=

# --- Bootstrap org/project/user + a fixed API key pair (optional but
# convenient: skips the signup wizard and gives ../1.service and
# ../2.inference a ready-to-use LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY on
# first startup). Leave blank to set these up manually in the UI instead. ---
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_ORG_NAME=
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_PROJECT_NAME=
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=
