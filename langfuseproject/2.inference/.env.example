# Hugging Face token with access to the mistralai/Ministral-3-3B-Instruct-2512
# license accepted at https://huggingface.co/mistralai/Ministral-3-3B-Instruct-2512
HUGGING_FACE_HUB_TOKEN=

# Triton container tag: <YY.MM>-vllm-python-py3. Check
# https://catalog.ngc.nvidia.com/orgs/nvidia/containers/tritonserver/tags
# for the latest available tag; 26.07 (vLLM 0.24.0, has mistral3 support) is
# the latest verified at write time.
TRITON_IMAGE_TAG=26.07

# Langfuse API keys for this project, created via LANGFUSE_INIT_PROJECT_* in
# ../langfuse/.env (auto-provisioned on first startup), or manually at
# http://localhost:3001 -> Settings -> API Keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
