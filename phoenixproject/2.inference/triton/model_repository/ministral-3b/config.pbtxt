backend: "vllm"

# vLLM handles batching internally; disable Triton-side batching.
max_batch_size: 0

# Required for the vLLM backend to saturate throughput.
model_transaction_policy {
  decoupled: True
}

input [
  {
    name: "text_input"
    data_type: TYPE_STRING
    dims: [ 1 ]
  }
]
output [
  {
    name: "text_output"
    data_type: TYPE_STRING
    dims: [ 1 ]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_MODEL
  }
]
