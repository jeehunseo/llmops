# docker compose가 읽는 오버라이드 값. 미설정 시 compose의 기본값이 쓰인다.

LOG_LEVEL=INFO

# --- 회수 타이밍 ---
# worker 사망 감지 시간. job의 정상 실행 시간이 아니라 "죽었다고 판단할 시간"으로 잡는다.
CLAIM_IDLE_MS=30000
# CLAIM_IDLE_MS 안에 최소 2회 실행되어야 한다 (HEARTBEAT*2000 <= CLAIM_IDLE_MS).
HEARTBEAT_INTERVAL_SEC=10
RECLAIM_INTERVAL_SEC=3
READ_BLOCK_MS=3000

# --- 재시도 ---
# 회수 허용 횟수. 초과하면 DLQ로 간다.
MAX_RETRIES=5

# --- 종료 ---
# SIGTERM 후 실행 중 job에 줄 완주 시간. 정상 job의 최대 실행 시간에 맞춘다.
SHUTDOWN_GRACE_SEC=60
# 위 값보다 커야 한다. 작으면 drain 도중 SIGKILL된다.
STOP_GRACE_PERIOD=70s

# --- janitor ---
# CLAIM_IDLE_MS * 2 이상이어야 한다. 살아 있는 worker 등록이 지워지지 않도록.
CONSUMER_IDLE_MS=300000
JANITOR_INTERVAL_SEC=60
# JANITOR_INTERVAL_SEC보다 작아야 한다.
JANITOR_LOCK_TTL_SEC=55
TRIM_ENABLED=true

# --- 보관 ---
DEAD_MAXLEN=10000
JOB_TTL_SEC=604800

# --- API 입력 상한 ---
MAX_STEPS=100
MAX_STEP_DELAY_SEC=3600
