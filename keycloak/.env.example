# 로컬 개발용. .env 로 복사하면 pydantic-settings 가 읽는다.

# 서버 간 통신(토큰 교환)에 쓰는 주소. 호스트에서 uvicorn 을 직접 띄울 때는
# compose 가 매핑한 8180 을 쓰고, 컨테이너(auth-api) 안에서는
# http://keycloak:8080 이 docker-compose.yml 로 주입된다.
KEYCLOAK_BASE_URL=http://localhost:8180

# 브라우저가 리다이렉트로 여는 주소. 서버 간 주소와 달라질 수 있어 분리한다.
KEYCLOAK_PUBLIC_BASE_URL=http://localhost:8180

KEYCLOAK_REALM=llmops

# API 클라이언트 (password grant). secret 은 realm/llmops-realm.json 의 값과
# 같아야 한다. 실제 환경에서는 import 파일에 secret 을 넣지 말고 여기서만 주입한다.
KEYCLOAK_CLIENT_ID=llmops-api
KEYCLOAK_CLIENT_SECRET=llmops-api-secret

# 웹 클라이언트 (authorization code + PKCE)
KEYCLOAK_WEB_CLIENT_ID=llmops-web
KEYCLOAK_WEB_CLIENT_SECRET=llmops-web-secret

# Keycloak 클라이언트에 등록된 값과 글자 단위로 같아야 한다.
WEB_REDIRECT_URI=http://localhost:3200/auth/callback
WEB_POST_LOGOUT_URI=http://localhost:3200/web

# 서버 세션 수명(초)
SESSION_TTL=1800

# Keycloak 호출 타임아웃(초)
KEYCLOAK_TIMEOUT=5.0
