# Local development. Copy to .env; it is read by pydantic-settings.
ENV=dev

# Empty -> MemorySaver (in-process, lost on restart).
# Set -> AsyncPostgresSaver, e.g. postgresql://agent:agent@localhost:5432/agent
POSTGRES_URL=

# OpenAI-compatible endpoint. Inside llmops-net use http://inference-api:8080/v1;
# from the host, the compose file in ../langfuseproject/2.inference maps :8080.
INFERENCE_BASE_URL=http://localhost:8080/v1
INFERENCE_API_KEY=not-needed
MODEL_NAME=ministral-3b

# Langfuse keys, same provisioning as ../langfuseproject/1.service.
# Leave empty to disable tracing entirely.
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
